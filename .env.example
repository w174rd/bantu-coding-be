# Application
APP_NAME=Bantu Coding
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL
# NOTE: on this machine PostgreSQL 18 listens on 5433, NOT the default 5432.
# Port 5432 belongs to PostgreSQL 17, and 5434 to PostgreSQL 14. CLAUDE.md
# requires 18, so leaving this at 5432 silently connects to the wrong server.
DB_HOST=127.0.0.1
DB_PORT=5433
# Left blank deliberately. The real role, password, and database name are not
# published in this file — fill them in .env, which is gitignored.
DB_USER=
DB_PASSWORD=
DB_NAME=

# Comma-separated allowlist of browser origins.
# Never use "*" — see CLAUDE.md section 6.3, item 6.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI provider config encryption (encrypts api_key at rest in the
# ai_provider_configs table). No default in Settings on purpose: a missing key
# must fail at startup, not at the first provider call.
# Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating it orphans every stored API key -- they become undecryptable and have
# to be re-entered through PATCH /api/v1/ai-provider-configs/{id}.
AI_CONFIG_ENCRYPTION_KEY=

# Max size of an uploaded .txt/.md discussion document, in bytes (256 KiB).
DOCUMENT_MAX_BYTES=262144

# Discussion room
# Total characters of room history sent to the provider per persona turn; oldest
# messages are dropped first. Characters, not tokens, so no per-vendor tokenizer
# is needed -- roughly 3.5 chars/token, so 10000 ~= 2900 tokens.
CHAT_HISTORY_CHAR_BUDGET=10000

# Cap on a single persona reply. Personas write chat messages, not documents.
PERSONA_MAX_TOKENS=4096

# The Arbiter steps in every N rounds to score the options and write a ticket.
# A conversation can override this in its arbiter_every_n_rounds column.
ARBITER_EVERY_N_ROUNDS=2
